# Resend — https://resend.com/api-keys (sending-only key; domain teninlanimi.xyz verified)
RESEND_API_KEY=

# Optional: where contact-form enquiries are delivered (defaults to teninlanimitaiwo@gmail.com)
CONTACT_TO_EMAIL=

# Optional: canonical site origin for metadata, sitemap and email images.
# Must be the host that serves the site without redirecting (defaults to https://www.teninlanimi.xyz)
NEXT_PUBLIC_SITE_URL=

# Optional: Google Search Console HTML-tag verification token (content="..." value only).
# Not needed if you verify the domain via a DNS TXT record.
GOOGLE_SITE_VERIFICATION=
